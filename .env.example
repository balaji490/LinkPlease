# PseudoGram API Configuration
PSEUDOGRAM_BASE_URL=https://pseudogram-api.onrender.com
PSEUDOGRAM_API_KEY=your_api_key_here

# Database Configuration
DATABASE_PATH=linkplease.db

# Outbound Rate Limiting (10 requests per 60 seconds)
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60.0

# Retry & Resilience Settings
MAX_RETRIES=5
INITIAL_RETRY_BACKOFF_SECONDS=1.0
MAX_RETRY_BACKOFF_SECONDS=30.0

# Polling Intervals
WORKER_POLL_INTERVAL=0.2
RECONCILER_INTERVAL=1.5
RECONCILER_BATCH_SIZE=20

# Security
VERIFY_SIGNATURE=false

# Server Settings
HOST=0.0.0.0
PORT=8000
